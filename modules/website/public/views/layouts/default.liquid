---
metadata: {
    layout_name: Website - Default
}
---
{%- include "modules/website/cache/layout_fragment_cache_key" -%}

<!doctype html>
<html class="no-js" lang="en">
<head>
    {% include 'modules/website/layout/technical_head' %}
</head>
<body class="flex-container flex-dir-column body-height-100">
    <div class="main-wrap">      
        {% include 'modules/website/layout/header' %} 
        {% include 'modules/website/layout/header_mobile' %}
        {{ content_for_layout }}
    </div>

    {% if context.params.slug == blank %}
        {% assign stickyFooter = true %}
    {% endif %}

    {% include 'modules/website/layout/footer', stickyFooter: stickyFooter %}

</body>
</html>