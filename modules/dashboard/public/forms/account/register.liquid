---
name: register
resource: User
resource_owner: anyone
flash_alert: Sorry-Signup
flash_notice: Congratulations-Signup
redirect_to: account-created
fields:
  # User Fields
  email:
    validation: 
      unique:
        message: Email already exist
      presence:
        message: Please use a valid email address
      email: 
        message: Please use a valid email address      
  password:
    validation: 
      presence: 
        message: Invalid Password
  first_name:
    validation: 
      presence: 
        message: First name is required
  last_name:
    validation: 
      presence: 
        message: Last name is required

async_callback_actions:
  delay: 0
  priority: high
  max_attempts: 2
  content: >
    {% comment %} Verification Token {% endcomment %}
    {%  liquid
        graphql temporary_token = 'modules/dashboard/account/generate_user_temporary_token', email: form.email 
    %}
    {% comment %} Update user client profile for authentication {% endcomment %}
    {% liquid
      graphql configure_user_otp = 'modules/dashboard/account/2fa/configure_user_otp', id: form.id , otp_configured: false
      log configure_user_otp
    %}
    
    {% comment %} Create Event Stream {% endcomment %}
    {% parse_json info %}
    {
      "description": "New Registration",
      "log": {
        "first_name": "{{ form.first_name }}",
        "last_name": "{{ form.last_name }}",
        "email": "{{ form.email }}"
      }
    }
    {% endparse_json %}
    {% include 'modules/dashboard/events/log_event', info %}
---

{%- form 
    html-id: "register-form"
    html-class: 'insites-form insites-form-code' 
    html-novalidate: true
    html-enctype="multipart/form-data"
    html-onsubmit:"return Session.events.signUpHandler(event, 'personal-details-container');" -%}

  <div class="insites-form-grid">
    {% include 'modules/dashboard/account/registration_personal_details' %}
  </div>
{%- endform -%}