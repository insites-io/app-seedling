---
name: sign_in
resource: Session
resource_owner: anyone
flash_notice: 'Successful'
flash_alert: 'Sorry-SignIn'
redirect_to: >
  {% graphql check_2fa_setup = 'modules/dashboard/account/check_2fa_setup'%}
  {% assign otp_configured = check_2fa_setup.current_user.client[0].otp_configured %}
  {%- if otp_configured == true -%}
    {%- assign go_to = '/verify-2fa' -%}
  {%- else -%}
    {%- assign go_to = '/dashboard' -%}
  {%- endif -%}
  {{ go_to }}
fields:
  email:
    validation: 
      presence:
        message: Please use a valid email address
      email: 
        message: Please use a valid email address
  password:
    validation: 
      presence:
        message: Password is required
  redirect:
    property_options:
        virtual: true
callback_actions: >
  {% liquid
      graphql configure_user_otp = 'modules/dashboard/account/2fa/configure_user_otp', id: context.current_user.id , is_currently_logged_in: true
  %}
---

{%- form 
	html-id: "sign-in-form"
	html-novalidate: true
  html-enctype="multipart/form-data"
  html-onsubmit:"return LoginScript.methods.validateForm(event);" -%}
	
	<div class="grid-x grid-padding-x">
		<div class="small-12 cell">
			<ins-input validate
				id="email"
        label="Email"
        field="email"
        name="{{ form.fields.email.name }}" 
        value="{{ form.fields.email.value }}" 
        {% if form.errors['email'] %} has-error {% endif %}
        error-message="{{ form.fields.email.validation.rules.presence.message }}"
        placeholder="Email">
			</ins-input>

      <ins-input validate
          id="password"
          label="Password"
          field="password"
          name="{{ form.fields.password.name }}" 
          value="{{ form.fields.password.value }}" 
          placeholder="Password">
      </ins-input>
    </div>

    {%- if form.errors -%}
    <div class="small-12 cell">
			<p class="warning">{{ form.errors['password'] }}</p>
		</div>
  	{%- endif -%}

		<div class="cell grid-x">
			<div class="cell text-right">
				<a class="font-color-body" href="/forgot-password">Forgot your password?</a>
			</div>
		</div>
		<div class="small-12 cell spacer x-large">
    {%- if context.flash.alert and context.flash.alert != 'Sorry-SignIn' -%}
      <div class="spacer small"></div>
    {%- endif -%}
    </div>

    <input type="hidden" 
        name="{{ form.fields.redirect.name }}" 
        value="{{ context.page.slug }}" >

    <div class="small-12 cell text-center">
			<ins-button id="submit-btn" label="SIGN IN" class="full" solid color="blue" type="submit" ></ins-button>
      <div class="spacer small"></div>
      <a href="/register"><ins-button id="register-btn" type="button" label="REGISTER" class="full"  color="white" ></ins-button></a>
		</div>

	</div>

{%- endform -%}