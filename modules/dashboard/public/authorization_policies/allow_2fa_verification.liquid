---
name: allow_2fa_verification
redirect_to: 403
metadata: {
    "auth_policy_name": "Allow 2FA Verification",
    "auth_policy_key": "allow_2fa_verification"
}
---

{% liquid
  graphql check_2fa_setup = 'modules/dashboard/account/check_2fa_setup'
  assign user = check_2fa_setup.current_user.client | first

  comment
    Only users without an active session should be allowed to perform the
    2FA verification flow. If the profile is missing, deny.
  endcomment
  if user == blank
    echo false
    return
  endif

  assign is_currently_logged_in = user.is_currently_logged_in

  comment
    If the session is already active, block verification to prevent replays.
  endcomment
  if is_currently_logged_in == true
    echo false
  else
    echo true
  endif
%}