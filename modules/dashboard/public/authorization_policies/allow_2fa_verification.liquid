---
name: allow_2fa_verification
redirect_to: 403
metadata: {
    "auth_policy_name": "Allow 2FA Verification"
}
---

{% liquid
  graphql check_2fa_setup = 'modules/dashboard/account/check_2fa_setup'
  assign current_user = check_2fa_setup.current_user
  assign user = current_user.client | first

  comment
    Only sessions that have not passed 2FA yet should see the verification
    flow. If the profile is missing, deny.
  endcomment
  if user == blank
    echo false
    return
  endif

  assign current_user_id = current_user.id | append: ''
  assign passed_user_id = context.session.two_factor_user_id | append: ''

  comment
    If this session already passed 2FA, block verification to prevent replays.
  endcomment
  if passed_user_id == current_user_id
    echo false
  else
    echo true
  endif
%}
