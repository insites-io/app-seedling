---
name: is_2FA_activated
redirect_to: 403
metadata: {
    "auth_policy_name": "2FA Configuration",
    "auth_policy_key": "is_2FA_activated"
}
---

{% liquid
  graphql check_2fa_setup = 'modules/dashboard/account/check_2fa_setup'
  assign user = check_2fa_setup.current_user.client | first

  comment
    Guard 2FA-protected actions by requiring the profile and an activated OTP
    flag. Missing profile denies by default.
  endcomment
  if user == blank
    echo false
    return
  endif

  assign otp_configured = user.otp_configured

  comment
    Echo false explicitly when OTP is not configured to avoid relying on
    Liquid truthiness for booleans.
  endcomment
  if otp_configured == false
    echo false
  else
    echo true
  endif
%}
