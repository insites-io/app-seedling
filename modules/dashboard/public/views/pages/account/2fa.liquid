---
method: post
metadata: {
    page_name: "API - 2FA Config",
}
authorization_policies:
  - modules/dashboard/is_user_logged_in
---

{% liquid
  assign otp_code = context.params | fetch: "2fa" | fetch: "otp_code"
  assign from_page = context.params.from_page
  function return_to = 'modules/dashboard/account/safe_return_to', path: context.params.return_to

  comment
    The code is always checked against the signed-in user, never an email from the request.
  endcomment
  assign object = {}
  assign object['id'] = context.current_user.id
  assign object['otp_code'] = otp_code

  function allowed = 'modules/dashboard/account/rate_limit/allow', action: 'otp', key: context.current_user.id, max_per_key: 5, max_per_ip: 50
  if allowed
    function object = 'modules/dashboard/account/2fa_functions/verify_otp', object: object
  else
    assign object['valid'] = false
  endif

  assign now = "now" | date: "%Y-%m-%d %H:%M"

  if object.valid
    graphql configure_user_otp = 'modules/dashboard/account/2fa/configure_user_otp', id: context.current_user.id, otp_configured: true
    graphql passed_2fa = 'modules/dashboard/account/create_session', name: "two_factor_user_id", value: context.current_user.id
    graphql update_last_login_date = 'modules/dashboard/account/log_last_login_date', id: context.current_user.id, date: now

    if from_page == 'profile'
      assign goto = '/profile?status=success'
    else
      assign goto = '/dashboard'
    endif

    comment
      Redirect to the original destination only when it is a path on this site.
    endcomment
    if return_to != blank
      assign goto = return_to
    endif
    redirect_to goto
  else
    assign goto = '/verify-2fa?status=failed'
    if from_page == 'setup-2fa'
      assign goto = '/setup-2fa?status=failed'
    endif

    if from_page == 'profile'
      assign goto = '/profile?status=failed'
    endif

    redirect_to goto
  endif
%}
