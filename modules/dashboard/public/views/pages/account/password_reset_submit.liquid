---
slug: password-reset
method: post
layout: ''
searchable: false
metadata: {
    page_name: "Password Reset - Submit",
}
---

{%- liquid
  assign email = context.params.email | default: '' | strip | downcase
  assign token = context.params.token | default: '' | strip
  assign password = context.params.password | default: ''
  assign password_confirmation = context.params.password_confirmation | default: ''

  comment
    Check the token before changing anything. A made-up or used token never reaches the update.
  endcomment
  function check = 'modules/dashboard/account/password_reset_token', email: email, token: token
  unless check.valid
    redirect_to '/password-reset'
    break
  endunless

  assign encoded_token = token | url_encode
  assign encoded_email = email | url_encode
  assign back = '/password-reset?token=' | append: encoded_token | append: '&email=' | append: encoded_email
  if password == blank or password != password_confirmation
    assign back = back | append: '&error=mismatch'
    redirect_to back
    break
  endif

  comment
    Sets the new password and clears the stored token in one update, so the link works once.
  endcomment
  graphql result = 'modules/dashboard/account/reset_password', id: check.user_id, password: password
  if result.errors != blank
    assign back = back | append: '&error=invalid_password'
    redirect_to back
    break
  endif

  comment
    A reset clears 2FA lockouts and recent code attempts, so the user can sign in with 2FA again.
  endcomment
  assign user_key = check.user_id | append: ''
  graphql cleared_lockouts = 'modules/dashboard/account/rate_limit/delete_key_attempts', action: 'otp_lockout', key: user_key
  graphql cleared_codes = 'modules/dashboard/account/rate_limit/delete_key_attempts', action: 'otp', key: user_key

  redirect_to '/password-reset?reset=done'
-%}
