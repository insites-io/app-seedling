---
slug: password-reset
layout: modules/dashboard/system_pages
searchable: false
max_deep_level: 1
metadata: {
    "status": "published",
    "open_graph_url": "{{ context.exports.global.company_url | strip }}",
    "open_graph_type": "",
    "open_graph_image": "",
    "open_graph_title": "Password Reset",
    "open_graph_description": "Password Reset",
    "open_graph_site_name": "{{ context.exports.global.company_name | strip }}",
    "meta_title": "Password Reset",
    "page_title": "Password Reset | Seedling",
    "page_name": "Password Reset",
    "meta_description": "Password Reset",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "is_sitemap_enabled": false,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "0", ## secondary order (ASC)
    "sitemap_change_frequency": "never"
}
---
{%- liquid
    assign email = context.params.email | default: '' | strip | downcase
    assign token = context.params.token | default: '' | strip
    function check = 'modules/dashboard/account/password_reset_token', email: email, token: token
-%}

{%- if context.params.reset == 'done' -%}
    {%- parse_json messageInfo -%}
    {
        "title" : "Success",
        "type": "success",
        "message": "<p class='seedling-form-container-link'>Your password has been reset. You can now proceed to <a href='/sign-in'>sign in.</a></p>"
    }
    {%- endparse_json -%}
    {%- include 'modules/dashboard/system/form_result', messageInfo: messageInfo -%}

{%- elsif check.valid -%}
    {%- render 'modules/dashboard/account/password_reset_form', context: context, email: email, token: token -%}

{%- else -%}
    {%- comment -%}
    The link is invalid when the user does not exist, the token does not match the
    stored one (it is cleared after one use), or the platform says it has expired.
    {%- endcomment -%}
    <div class="sign-up">
        <div class="spacer section"></div>
        <div class="grid-x align-center">
            <div class="large-5 medium-9 samll-12 cell">
                <div class="spacer xxx-large"></div>
                <div class="large-12 medium-12 small-12 cell text-center">
                    <div class="system-pages warning spacer">
                        <i class="icon-alert-triangle"></i>
                    </div>
                    <h2 class="sub-title">Invalid Token</h2>
                    <div class="spacer small"></div>
                    <div class="context">
                        <p>Unfortunately, provided token is not valid anymore. Please request password instructions again.</p>
                    </div>
                    <div class="spacer x-large"></div>
                    <a href="/forgot-password">
                        <ins-button class="margin-top-small" label="Request a new reset link" color="solid blue"></ins-button>
                    </a>
                </div>
            </div>
        </div>
    </div>
{%- endif -%}


<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.0/axios.min.js"></script>
{%- if context.environment == "staging" -%}
    <script src="{{ 'modules/dashboard/services/apiServices.js' | asset_url }}"></script>
    <script src="{{ 'modules/dashboard/scripts/login-scripts.js' | asset_url }}"></script>
{%- else -%}
    <script src="{{ 'modules/dashboard/services/apiServices.min.js' | asset_url }}"></script>
    <script src="{{ 'modules/dashboard/scripts/login-scripts.min.js' | asset_url }}"></script>
{%- endif -%}