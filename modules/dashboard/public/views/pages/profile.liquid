---
slug: profile
layout: modules/dashboard/form
searchable: false
max_deep_level: 1
metadata: {
    "status": "published",
    "page_name": "Profile",
    "open_graph:url": "{{ context.exports.global.company_url | strip }}",
    "open_graph:type": "",
    "open_graph:image": "",
    "open_graph:title": "Profile",
    "open_graph:description": "Profile",
    "open_graph:site_name": "{{ context.exports.global.company_name | strip }}",
    "meta_title": "Profile",
    "page_title": "Profile | Seedling",
    "meta_description": "Profile",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "sitemap_enabled": false,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "0", ## secondary order (ASC)
    "sitemap_changefreq": "never",
    "heading": "Profile"
}
authorization_policies:
  - modules/dashboard/is_user_logged_in
  - modules/dashboard/is_2fa_verified
---

{%- if context.environment == "staging" -%}
<!-- start page: my-details  -->
{%- endif -%}

{%- graphql user = 'modules/dashboard/account/get_current_user' | dig: 'current_user' -%}  

{% comment %} Check if CRM Contact was assigned already to CRM Company {% endcomment %}
{%- if user.crm_contact[0].company_uuid != user.client[0].company_uuid -%}
  {%- parse_json data -%}
  {
    "company_uuid": "{{user.client[0].company_uuid}}",
    "contact_ids": {{user.id}}
  }
  {%- endparse_json -%}
  {%- graphql assign_company_contact = 'modules/website/trigger_api_call', 
      name: 'modules/dashboard/assign_company_contact', 
      data: data | dig: 'items','response','body' | parse_json -%}     
{%- endif -%}

{% comment %} Check if user verified their account {% endcomment %}
{%- liquid
    if user.client
        assign profile = user.client[0]
        if profile != blank and profile.is_activated
            assign verified = true
        else
            assign verified = false            
        endif
    endif    
-%}

{% comment %} Get CRM -> Contact from v5 API {% endcomment %}
{% parse_json data %} 
{
  "id": "{{user.external_id}}"
}
{% endparse_json %}
{% liquid
    graphql contact_api = 'modules/website/trigger_api_call', name: 'modules/dashboard/get_contact', data: data 
    assign contact = contact_api.items.response.body | parse_json | dig: 'items','results' | first
%}


{% comment %} Get CRM -> Contact Address from v5 API {% endcomment %}
{% parse_json data %} 
{
  "contact_uuid": "{{ user.external_id }}"
}
{% endparse_json %}
{% liquid
    graphql contact_address_api = 'modules/website/trigger_api_call', name: 'modules/dashboard/get_contact_address', data: data 
    assign contact_address = contact_address_api.items.response.body | parse_json | dig: 'items'

    if contact_address.total_entries == 0
      assign default_address = '' | parse_json
    else
      for item in contact_address.results
        if forloop.first == true
          assign default_address = item
        endif
        if item.properties.uuid == contact.contact[0].properties.default_address_uuid 
          assign default_address = item
        endif
      endfor
    endif

    assign contact = contact | add_hash_key: "default_address", default_address
%}


<div class="my-details">    

    
     {%- if verified == false -%}
      <div class="small-12 cell text-center">
        {% comment %} <div class="spacer x-large"></div> {% endcomment %}
        {% comment %} {%- include_form "modules/dashboard/resend_verification", id: context.current_user.id -%} {% endcomment %}
      </div>
    {%- endif -%} 
    <div class="spacer x-large"></div>
    <div class="grid-container">
      <div class="grid-x">
        <div class="large-4 medium-4 small-12 cell profile-form-left">
          <h3 class="heading-3">Personal Information</h3>
          <p>Update your account’s profile information and email address.</p>
        </div>
        <div class="large-8 medium-8 small-12 cell profile-form-right">
          {%- include_form 'modules/dashboard/my_details', id: user.id, data: contact -%}
        </div>
      </div>

      <div class="spacer xxxx-large"></div>
      <div class="grid-x">
          <div class="large-4 medium-4 small-12 cell profile-form-left"> 
            <h3 class="heading-3">Update Password</h3>
            <p>Ensure your account is using a long, random password to stay secure.</p>
          </div>
          <div class="large-8 medium-8 small-12 cell profile-form-right">
            {%- include_form 'modules/dashboard/change_password', id: user.id -%}
          </div>
      </div>

      <div class="spacer xxxx-large"></div>
      <div class="grid-x">
          <div class="large-4 medium-4 small-12 cell profile-form-left"> 
            <h3 class="heading-3">Two-Factor Authentication</h3>
            <p>Add additional security to your account using two-factor authentication.</p>
          </div>
          <div class="large-8 medium-8 small-12 cell profile-form-right">
            {% graphql check_2fa_setup = 'modules/dashboard/account/check_2fa_setup'%}
            {% assign otp_configured = check_2fa_setup.current_user.client[0].otp_configured %}
            {%- if otp_configured == true -%}
              {% include 'modules/dashboard/account/2fa_activated' %}
            {% else %}
              {% include 'modules/dashboard/account/setup_2fa' %}
            {% endif %}
          </div>
      </div>
    </div>
        
    <div class="spacer x-large"></div>
</div>


{%- if context.params.status == 'success'  -%}
  <script>
    const url = new URL(window.location);
    url.searchParams.delete('status');
    window.history.replaceState({}, document.title, url);
      setTimeout(() => {
          App.events.notyf("success", 
              "Your two-factor authentication was setup successfully");
      }, 200)
  </script>
{% endif -%}

{% comment %} Search Address Script {% endcomment %}
{% include 'modules/dashboard/layouts/googlemaps' %}

<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.0/axios.min.js"></script>
{%- if context.environment == "staging" -%}
  <script src="{{ 'modules/dashboard/scripts/address-lookup.js' | asset_url }}"></script>
  <script src="{{ 'modules/dashboard/scripts/user-profile.js' | asset_url }}"></script>
{%- else -%}
  <script src="{{ 'modules/dashboard/scripts/address-lookup.min.js' | asset_url }}"></script>
  <script src="{{ 'modules/dashboard/scripts/user-profile.min.js' | asset_url }}"></script>
{%- endif -%}

{%- if context.flash and context.flash.notice == "Success-My-Details" -%}
<script>
setTimeout(() => {
    App.events.notyf('success', "Account details has been updated.");
}, 200);
</script>
{% endif -%}

{%- if context.flash and context.flash.alert == "Error-My-Details" -%}
<script>
setTimeout(() => {
    App.events.notyf('error', "Error updating account detail.");
}, 200);
</script>
{% endif -%}

{%- if context.environment == "staging" -%}
<!-- end page: my-details  -->
{%- endif -%}