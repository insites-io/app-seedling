---
slug: generate-password-token
layout: application
max_deep_level: 3
authorization_policies:
  - modules/dashboard/is_user_logged_in
  - modules/dashboard/is_user_allowed
metadata: {
    api_endpoint_name: "generate-password-token",
    page_name: "API - Generate Password Token",
}
--- 

{%  liquid  
    assign email = context.current_user.email
    graphql generated = 'modules/dashboard/account/generate_user_temporary_token', email: email
    assign generated_token = generated.items.results | first

    if generated_token
    graphql res = 'modules/dashboard/account/update_password_token', id: generated_token.id, token: generated_token.temporary_token
    endif

    graphql result = 'modules/dashboard/account/get_user_with_password_token', email: email
    assign user_with_token = result.users.results | first
    assign user_data_default = user_with_token.default | first
    assign token = user_data_default.password_token | url_encode
    assign encoded_email = email | url_encode
    assign url = '/password-reset?token=' |  append: token | append: '&email=' | append: encoded_email

    redirect_to url
%}
