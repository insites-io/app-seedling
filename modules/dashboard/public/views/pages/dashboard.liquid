---
slug: dashboard
layout: modules/dashboard/default
searchable: true
max_deep_level: 1
metadata: {
    "status": "published",
    "page_name": "Dashboard",
    "open_graph:url": "",
    "open_graph:type": "",
    "open_graph:image": "",
    "open_graph:title": "Dashboard | Seedling",
    "open_graph:description": "Dashboard | Seedling",
    "open_graph:site_name": "",
    "meta_title": "Dashboard | Seedling",
    "page_title": "Dashboard | Seedling",
    "meta_description": "Dashboard | Seedling",
    "canonical_url": "",
    "is_visible_to_search_engines": true,
    "sitemap_enabled": true,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "1", ## secondary order (ASC)
    "sitemap_changefreq": "monthly"
}
dynamic_cache:
  layout: true
  key: |-
    {%- parse_json models -%}
    [
      "modules/insites_site_manager/insites_global_content",
      "modules/insites_core/insites_system_fields",
      "modules/dashboard/client_portal_banners"
    ]
    {%- endparse_json -%}
    {%- include "modules/website/cache/generate_cache_key", models: models -%}
    {{context.current_user.id}}
    {{context.device.device_type}}
authorization_policies:
  - modules/dashboard/is_user_logged_in
---
{%- comment -%} Pagination and Filters {%- endcomment -%}
{%  liquid            
    assign page_num = context.params.page | default: 1 | plus: 0
    assign per_page = context.params.per_page | default: 6 | plus: 0
%}


{% graphql check_2fa_setup = 'modules/dashboard/account/check_2fa_setup'%}
{% assign user = check_2fa_setup.current_user.client | first %}
{% assign is_currently_logged_in = user.is_currently_logged_in %}
{% assign otp_configured = user.otp_configured %}

{% if otp_configured == true and is_currently_logged_in == false  %}
  {% redirect_to '/verify-2fa' %}
{% endif %}


{% include 'modules/dashboard/dashboard/dashboard_contents' %}

{%- if context.environment == "staging" -%}
<!-- start page: overview  -->
{%- endif -%} 



<script>
      // Pagination

      var insBaseTable = document.getElementById('insBaseTable');

      insBaseTable.pageSizeOptions = [6,15,30];
      insBaseTable.totalCount = {{ data.size }};
      insBaseTable.pageNumber = {{page_num}};
      insBaseTable.pageSize = {{per_page}};

      if(insBaseTable){
          setTimeout(() => {
              insBaseTable.querySelector(".ibt-table-wrap__pagination>span").innerHTML='Items per page';
          },600);            
      }

      insBaseTable.addEventListener('insPaginationChange', tablePaginationHandler);

      function processTableData(){

          // Get the current URL
          const currentUrl = window.location.href;

          // Remove any existing `page` and `per_page` query parameters
          const newUrl = currentUrl.replace(/[?&]page=\d+/, '').replace(/[?&]per_page=\d+/, '');

          // Set the new `page` and `per_page` values
          const newPage = pageNumber;
          const newPerPage = pageSize;

          // Append the new `page` and `per_page` query parameters to the URL
          const updatedUrl = `${newUrl}?page=${newPage}&per_page=${newPerPage}`;

          // Navigate to the updated URL
          window.location.href = updatedUrl;
      }

      function tablePaginationHandler(event){
          pageSize = event.detail.pageSize;
          pageNumber = event.detail.pageNumber;
          processTableData()
      }
</script>