{% comment %} ? GET USER {% endcomment %}
{%- graphql user = 'modules/dashboard/account/get_current_user' | dig: 'current_user' -%}
{% graphql get_user_custom_field = 'modules/dashboard/account/get_contact_custom_fields', contact_uuid: user.external_id  | dig: 'items', 'results' | first %}

{% assign user_name = user.name %}
{% assign user_external_id = user.external_id %}
{% assign is_primary_account_holder = get_user_custom_field.primary_account_holder %}

{% parse_json user_and_company_details %} 
{
  "user_name": "{{ user_name }}",
  "user_external_id": "{{ user_external_id }}",
  "is_primary_account_holder": {{ is_primary_account_holder | default: false }}
}
{% endparse_json %}

{% return user_and_company_details %}
