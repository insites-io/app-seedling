---
metadata: {
    partial_name: "Account | Password Reset Token",
}
---
{%- comment -%}
  Finds the user for a password reset link and checks its token. Called with:
    function check = 'modules/dashboard/account/password_reset_token', email: email, token: token
  Returns { "user_id": ..., "valid": true|false }. Valid only when all three hold:
    1. A user exists for the email
    2. The token matches the one stored for that user (cleared after one use)
    3. The platform accepts it as an unexpired temporary token for that user
{%- endcomment -%}
{%- liquid
  assign check = {}
  assign check['valid'] = false

  assign email = email | default: '' | append: '' | strip | downcase
  assign token = token | default: '' | append: '' | strip
  if email == blank or token == blank
    return check
  endif

  graphql result = 'modules/dashboard/account/get_user_with_password_token', email: email
  assign user = result.users.results | first
  if user.id == blank
    return check
  endif

  assign stored = user.default | first
  if stored.password_token == blank or stored.password_token != token
    return check
  endif

  assign token_valid = token | is_token_valid: user.id
  if token_valid
    assign check['user_id'] = user.id
    assign check['valid'] = true
  endif

  return check
-%}
