---
slug: api/users/:id
format: json
method: patch
authorization_policies:
  - is_user_logged_in
  - is_user_allowed
searchable: false
metadata: {
    "api_endpoint_name": "update-user",
    "status": "published",
    "open_graph:url": "",
    "open_graph:type": "",
    "open_graph:image": "",
    "open_graph:title": "Update User API",
    "open_graph:description": "Update User API",
    "open_graph:site_name": "",
    "meta_title": "Update User API",
    "page_title": "Update User API",
    "meta_description": "Update User API",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "sitemap_enabled": false,
    "sitemap_priority": "1.0",
    "sitemap_order": "9999",
    "sitemap_changefreq": "never"
}
---

{%- liquid
  assign user_id = context.params.id | default: context.params.resource_id | default: null
  
  # Verify user can only update their own account
  graphql current_user_data = 'account/get_current_user'
  assign current_user_id = current_user_data.current_user.id | default: null
  
  if current_user_id == blank
    include 'api/error_response', error_type: 'authorization', errors: '{"authorization": ["Authentication required"]}', status_code: 401
    return
  endif
  
  if user_id != current_user_id
    include 'api/error_response', error_type: 'authorization', errors: '{"authorization": ["You can only update your own account"]}', status_code: 403
    return
  endif
-%}

{%- if user_id -%}
  {%- form 'my_details', resource_id: user_id -%}
    {%- if form.errors.size > 0 -%}
      {%- include 'api/error_response', error_type: 'validation', errors: form.errors, status_code: 400 -%}
    {%- else -%}
      {%- parse_json response -%}
      {
        "success": true,
        "data": {
          "id": {{ form.id | json }},
          "email": {{ form.email | json }},
          "first_name": {{ form.first_name | json }},
          "last_name": {{ form.last_name | json }}
        },
        "valid": true
      }
      {%- endparse_json -%}
      {{ response }}
    {%- endif -%}
  {%- endform -%}
{%- else -%}
  {%- include 'api/error_response', error_type: 'validation', errors: '{"id": ["User ID is required"]}', status_code: 400 -%}
{%- endif -%}

