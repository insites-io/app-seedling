---
slug: api/disable-2fa
layout: application
format: json
method: post
searchable: false
authorization_policies:
  - has_passed_2fa
metadata: {
    api_endpoint_name: "disable-2fa"
}
---

{%- liquid
  comment
    Turning 2FA off needs a current code from the authenticator app, checked
    against the signed-in user. This never marks the session as having passed 2FA.
  endcomment
  assign object = {}
  assign object['id'] = context.current_user.id
  assign object['otp_code'] = context.params.otp_code

  function reset_required = 'account/two_factor_reset_required', user_id: context.current_user.id
  if reset_required
    response_status 429
    include 'api/error_response', error_type: 'rate_limit', errors: '{"otp_code": ["Too many attempts. Try again later."]}', status_code: 429
    break
  endif

  function allowed = 'account/rate_limit/allow', action: 'otp', key: context.current_user.id, max_per_key: 5, max_per_ip: 50
  unless allowed
    function locked = 'account/two_factor_lockout', user_id: context.current_user.id, email: context.current_user.email, max_per_key: 5
    response_status 429
    include 'api/error_response', error_type: 'rate_limit', errors: '{"otp_code": ["Too many attempts. Try again later."]}', status_code: 429
    break
  endunless

  function object = 'account/2fa_functions/verify_otp', object: object
  if object.valid
    function claimed = 'account/two_factor_claim_code', user_id: context.current_user.id, code: object.otp_code
    unless claimed
      assign object['valid'] = false
    endunless
  endif
  unless object.valid
    response_status 422
    include 'api/error_response', error_type: 'validation', errors: '{"otp_code": ["The code is not valid."]}', status_code: 422
    break
  endunless

  graphql configure_user_otp = 'account/2fa/configure_user_otp', id: context.current_user.id, otp_configured: false

  comment
    Replace the secret, so the old authenticator entry stops working and turning 2FA
    back on shows a new QR code.
  endcomment
  graphql refreshed = 'account/2fa/refresh_secret', user_id: context.current_user.id
-%}
{"success": true, "valid": true}
