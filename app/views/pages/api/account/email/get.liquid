---
slug: api/check-user-email-signup
format: json
method: get
layout: ''
searchable: false
metadata: {
    "api_endpoint_name": "check-user-email-signup",
    "page_name": "API - Check User Email",
    "is_visible_to_search_engines": false,
    "is_sitemap_enabled": false
}
---

{%- liquid
  comment
    The register form asks this before it submits, to tell someone early that their email
    is taken. It never returns a user id, and the register page checks again on the server.
  endcomment
  assign email = context.params.email | default: '' | append: '' | strip | downcase

  if email == blank
    response_status 400
    assign errors = { "email": ["Email parameter is required"] }
    render 'api/error_response', error_type: 'validation', errors: errors, status_code: 400
    break
  endif

  assign email_ok = email | is_email_valid
  unless email_ok
    response_status 422
    assign errors = { "email": ["Please use a valid email address"] }
    render 'api/error_response', error_type: 'validation', errors: errors, status_code: 422
    break
  endunless

  comment
    Limit how fast one visitor can probe for registered emails: 30 checks per IP address
    in 15 minutes.
  endcomment
  function allowed = 'account/rate_limit/allow', action: 'email_check', key: '', max_per_key: 0, max_per_ip: 30
  unless allowed
    response_status 429
    assign errors = { "email": ["Too many requests. Try again later."] }
    render 'api/error_response', error_type: 'rate_limit', errors: errors, status_code: 429
    break
  endunless

  graphql results = 'account/check_user_email_signup', email: email
  if results.errors != blank
    response_status 500
    assign errors = { "server": ["An error occurred while checking email"] }
    render 'api/error_response', error_type: 'server', errors: errors, status_code: 500
    break
  endif

  assign email_check = {}
  if results.items.total_entries > 0
    assign email_check['email_status'] = 'invalid'
    assign email_check['message'] = 'Email has already been used.'
  else
    assign email_check['email_status'] = 'valid'
    assign email_check['message'] = 'Email is valid'
  endif
-%}
{{ email_check }}
