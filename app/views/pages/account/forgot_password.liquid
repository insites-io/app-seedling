---
slug: forgot-password
layout: dashboard_account
searchable: false
max_deep_level: 1
metadata: {
    "status": "published",
    "open_graph_url": "{{ context.exports.global.company_url | strip }}",
    "open_graph_type": "",
    "open_graph_image": "",
    "open_graph_title": "Forgot Password",
    "open_graph_description": "Forgot Password",
    "open_graph_site_name": "{{ context.exports.global.company_name | strip }}",
    "meta_title": "Forgot Password",
    "page_title": "Forgot Password | Seedling",
    "page_name": "Forgot Password",
    "meta_description": "Forgot Password",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "is_sitemap_enabled": false,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "0", ## secondary order (ASC)
    "sitemap_change_frequency": "never"
}
---

{%- if context.current_user -%}    
    {%- redirect_to '/dashboard' -%} 
{%- endif -%} 

{%- if context.flash.notice != blank -%}

{%- parse_json messageInfo -%}
{
    "title" : "Success",
    "type": "success",
    "message": "<p class='seedling-form-container-link'>If you provided the right email, we will send you the reset password instructions.</p><div class='spacer'></div><p class='seedling-form-container-link'> Go to <a href='/sign-in'>sign in</a>"
}
{%- endparse_json -%}
{%- include 'system/form_result', messageInfo: messageInfo -%}

{%- else -%}
<div class="forgot-password-wrapper">
<div class="spacer section"></div>
    <div class="sign-up grid-x">
        <div class="large-offset-4 large-5 medium-offset-3 medium-8 small-12 cell seedling-form-container">
            <h1 class="heading-1 text-center">Forget your password?</h1>
            <div class="spacer x-small"></div>
            <p class="text-center">Enter your email address below and we'll get you back on track.</p>
            <div class="spacer xxx-large"></div>

            {%- include_form 'forgot_password' -%}
        </div>
    </div>
</div>
{%- endif -%}



<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.0/axios.min.js"></script>

{%- if context.environment == "staging" -%}
    <script src="{{ 'services/apiServices.js' | asset_url }}"></script>
    <script src="{{ 'scripts/login-scripts.js' | asset_url }}"></script>
{%- else -%}
    <script src="{{ 'services/apiServices.min.js' | asset_url }}"></script>
    <script src="{{ 'scripts/login-scripts.min.js' | asset_url }}"></script>
{%- endif -%}