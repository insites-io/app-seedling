---
slug: forgot-password
method: get
layout: dashboard_account
searchable: false
max_deep_level: 1
metadata: {
    "status": "published",
    "open_graph_url": "{{ context.exports.global.company_url | strip }}",
    "open_graph_type": "",
    "open_graph_image": "",
    "open_graph_title": "Forgot Password",
    "open_graph_description": "Forgot Password",
    "open_graph_site_name": "{{ context.exports.global.company_name | strip }}",
    "meta_title": "Forgot Password",
    "page_title": "Forgot Password | Seedling",
    "page_name": "Forgot Password",
    "meta_description": "Forgot Password",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "is_sitemap_enabled": false,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "0", ## secondary order (ASC)
    "sitemap_change_frequency": "never"
}
---


{%- liquid
  if context.current_user
    redirect_to '/dashboard'
    break
  endif

  comment
    The POST page checks this flag. A post without a valid authenticity token arrives with
    an empty session, so a missing flag means the token was missing or forged.
  endcomment
  graphql flagged = 'account/create_session', name: 'forgot_password_form', value: 'on'
-%}

{%- if context.params.sent == '1' -%}
    {%- capture message -%}<p class="seedling-form-container-link">If you provided the right email, we will send you the reset password instructions.</p><div class="spacer"></div><p class="seedling-form-container-link">Go to <a href="/sign-in">sign in</a></p>{%- endcapture -%}
    {%- render 'system/form_result', title: 'Success', message: message -%}
{%- else -%}
    {%- render 'account/forgot_password_form', email: '', error: context.params.error -%}
{%- endif -%}
