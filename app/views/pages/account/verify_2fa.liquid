---
slug: verify-2fa
method: get
layout: dashboard_account
searchable: false
metadata: {
    "status": "published",
    "open_graph_url": "{{ context.exports.global.company_url | strip }}",
    "open_graph_type": "",
    "open_graph_image": "",
    "open_graph_title": "Verify 2FA",
    "open_graph_description": "Verify 2FA",
    "open_graph_site_name": "{{ context.exports.global.company_name | strip }}",
    "meta_title": "Verify 2FA",
    "page_title": "Verify 2FA | Seedling",
    "page_name": "Verify 2FA",
    "meta_description": "Verify 2FA",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "is_sitemap_enabled": false,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "0", ## secondary order (ASC)
    "sitemap_change_frequency": "never"
}
authorization_policies:
  - is_2fa_activated
  - allow_2fa_verification
---

{%- liquid
  comment
    Clears the session flags the Insites admin keeps for its own 2FA and single sign-on.
  endcomment
  include 'modules/insites_crm/sessions/delete_session_variables'
  function return_to = 'account/safe_return_to', path: context.params.return_to
  assign action = '/account/2fa'
  if return_to != blank
    assign encoded_return_to = return_to | url_encode
    assign action = '/account/2fa?return_to=' | append: encoded_return_to
  endif
-%}
<div class="verify-2fa-wrapper">


<div class="spacer section"></div>

<form action="{{ action }}" method="post">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <div class="setup-2fa-container verification">
        <div class="grid-x">
            <div class="large-12 cell text-center">
                <div class="qr-code-details-wrapper">
                    <h1>
                        Verification Code
                    </h1>
                    <p class="paragraph-small">
                        Enter Verification Code generated by your authentication app.
                    </p>

                    <div class="spacer small"></div>

                    <div class="otp-input-wrapper">
                        <input name="2fa[otp_code]" type="hidden">
                        <input name="from_page" type="hidden" value="verify-2fa">


                        <div class="otp_input_fields">
                            {% for i in (0..5) %}
                                <input inputmode="numeric" pattern="[0-9]*" type="text" maxlength="1" class="otp_input" autocomplete="off" required disabled/>
                            {% endfor %}
                        </div>
                    </div>

                    {% if context.params.status %}
                        <div class="spacer x-small"></div>
                        <p class="paragraph-small is-invalid-label">
                            Invalid code please try again.
                        </p>
                    {% endif %}
                    <ins-button type="submit" class="hide fa-btn" label="Submit" id="submit_button" solid color="blue" size="large"></ins-button>
                </div>
            </div>
        </div>
    </div>
</form>


<div class="spacer section"></div>
</div>
<script src="{{ 'scripts/2fa/otp.js' | asset_url }}"></script>
