---
slug: profile/password
method: post
layout: ''
searchable: false
metadata: {
    page_name: "Profile - Change Password",
}
authorization_policies:
  - is_user_logged_in
  - is_user_allowed
---

{%- liquid
  assign current_password = context.params.current_password | default: '' | append: ''
  assign password = context.params.password | default: '' | append: ''
  assign password_confirmation = context.params.password_confirmation | default: '' | append: ''
  assign email = context.current_user.email | default: '' | strip | downcase

  comment
    Changing a password needs the current one, so a person at an unlocked browser cannot take
    the account over. A wrong one counts as a failed sign-in: the same action, the same key
    and the same limits as /sign-in (10 per email and 50 per IP address in 15 minutes), so a
    guess here and a guess there share one allowance. Check the limit first, without recording,
    and record only when the password is wrong.
  endcomment
  function allowed = 'account/rate_limit/allow', action: 'sign_in', key: email, max_per_key: 10, max_per_ip: 50, count_only: true
  unless allowed
    redirect_to '/profile?error=too_many'
    break
  endunless
  if current_password == blank
    redirect_to '/profile?error=current_required'
    break
  endif

  comment
    The platform checks the password (authenticate_password reads authenticate { password }),
    never this page. The row must also be the signed-in user's own.
  endcomment
  graphql auth = 'account/authenticate_password', email: email, password: current_password
  assign verified = auth.users.results | first
  assign verified_id = verified.id | append: ''
  assign own_id = context.current_user.id | append: ''
  if verified == blank or verified.authenticate.password != true or verified_id != own_id
    function recorded = 'account/rate_limit/record', action: 'sign_in', key: email
    redirect_to '/profile?error=current_invalid'
    break
  endif

  comment
    The same checks as the form in the browser, made again here because they are the
    ones that count.
  endcomment
  if password == blank
    redirect_to '/profile?error=password_required'
    break
  endif
  if password.size < 6
    redirect_to '/profile?error=password_short'
    break
  endif
  if password != password_confirmation
    redirect_to '/profile?error=password_mismatch'
    break
  endif

  graphql changed = 'account/change_password', id: context.current_user.id, password: password
  if changed.errors != blank
    redirect_to '/profile?error=password_invalid'
    break
  endif

  comment
    A new password signs this session out, as the form warns. Clear the 2FA pass first.
  endcomment
  graphql cleared = 'account/delete_session', name: 'two_factor_user_id'
  graphql signed_out = 'account/sign_out'
  redirect_to '/sign-out'
-%}
