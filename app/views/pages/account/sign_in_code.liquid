---
slug: sign-in/code
method: get
layout: dashboard_account
searchable: false
metadata: {
    "status": "published",
    "open_graph_url": "{{ context.exports.global.company_url | strip }}",
    "open_graph_type": "",
    "open_graph_image": "",
    "open_graph_title": "Enter Your Sign-In Code",
    "open_graph_description": "Enter Your Sign-In Code",
    "open_graph_site_name": "{{ context.exports.global.company_name | strip }}",
    "meta_title": "Enter Your Sign-In Code",
    "page_title": "Enter Your Sign-In Code | Seedling",
    "page_name": "Enter Your Sign-In Code",
    "meta_description": "Enter Your Sign-In Code",
    "canonical_url": "",
    "is_visible_to_search_engines": false,
    "is_sitemap_enabled": false,
    "sitemap_priority": "1.0",## primary order (DESC)
    "sitemap_order": "0", ## secondary order (ASC)
    "sitemap_change_frequency": "never"
}
---

{%- liquid
  if context.current_user
    redirect_to '/dashboard'
    break
  endif

  graphql flagged = 'account/create_session', name: 'sign_in_form', value: 'on'
  assign code_email = context.session.sign_in_code_email | default: ''
  comment
    An output tag on this platform turns an escaped double quote back into a quote, so a
    value that goes into an attribute is escaped here and written with print.
  endcomment
  assign code_email_attr = code_email | escape
-%}

<div class="sign-up-wrapper">
    <div class="spacer section"></div>
    <div class="sign-up grid-x grid-padding-x">
        <div class="large-5 medium-offset-3 medium-6 small-12 cell seedling-form-container">
            <h1 class="heading-1 text-center">Enter your sign-in code</h1>
            <div class="spacer x-small"></div>
            <p class="text-center">Enter the 6-digit code from the email we sent you.</p>
            <div class="spacer x-large"></div>

            <form id="sign-in-code-form" action="/sign-in/code" method="post" novalidate onsubmit="return FormValidation.validateAndSubmit(event);">
                <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">

                <div class="grid-x grid-padding-x">
                    <div class="small-12 cell">
                        <ins-input validate
                            id="email"
                            label="Email"
                            field="email"
                            name="email"
                            value="{% print code_email_attr %}"
                            error-message="Please use a valid email address"
                            placeholder="Email">
                        </ins-input>

                        <ins-input validate
                            id="code"
                            label="Code"
                            field="text"
                            name="code"
                            autocomplete="one-time-code"
                            error-message="Please enter the 6-digit code"
                            placeholder="6-digit code">
                        </ins-input>
                    </div>

                    <div class="small-12 cell spacer x-large">
                        <div class="spacer medium"></div>
                        {%- if context.params.sent == '1' -%}
                            <p>If that address has an account, a code is on its way. It works once, for 15 minutes.</p>
                        {%- elsif context.params.error == 'invalid' -%}
                            <p class="error-message">That code is not right. Check the code and the email address.</p>
                        {%- elsif context.params.error == 'expired' -%}
                            <p class="error-message">That code has expired. Please ask for a new one.</p>
                        {%- elsif context.params.error == 'too_many' -%}
                            <p class="error-message">Too many tries. Please wait, then ask for a new code.</p>
                        {%- elsif context.params.error == 'session' -%}
                            <p class="error-message">Your session has expired. Please try again.</p>
                        {%- elsif context.params.error == 'reset' -%}
                            <p class="error-message">For your security, this account needs a <a href="/forgot-password">password reset</a> before you can sign in.</p>
                        {%- endif -%}
                    </div>

                    <div class="small-12 cell text-center">
                        <ins-button id="submit-btn" label="SIGN IN" class="full" solid color="blue" type="submit"></ins-button>
                        <div class="spacer small"></div>
                        <a href="/sign-in/email-code"><ins-button id="new-code-btn" type="button" label="EMAIL ME A NEW CODE" class="full" color="white"></ins-button></a>
                        <div class="spacer x-large"></div>
                        <p class="seedling-form-container-link">Back to <a href="/sign-in">sign in</a></p>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="spacer section"></div>
</div>

<script defer src="{{ 'scripts/login-scripts.js' | asset_url }}"></script>
