---
metadata: {
    layout_name: Dashboard - Form
}
---
{%- comment -%} Used by the fragment cache in the layout {%- endcomment -%}

{% comment %} ? Enable Fragment cache after Installation {% endcomment %}
{% comment %} {%- include "cache/layout_fragment_cache_key" -%} {% endcomment %}

<!doctype html>
<html class="no-js" lang="en">
<head>
    {% include 'layout/technical_head' %}

    <script type="module" src="https://components.insites.io/v2/latest/insites.esm.js"></script>
    <script nomodule src="https://components.insites.io/v2/latest/insites.js"></script>
    {%- include 'insites_forms/insites_form_scripts' -%}

</head>
<body class="flex-container flex-dir-column body-height-100">
    <div class="main-wrap">
        {% include 'layout/header' %} 
        {% include 'layout/header_mobile' %}
        <div class="wrapper client-portal">
            <div class="grid-container">
                <div class="grid-x gutter-medium grid-padding-x">
                    <div class="large-12 medium-12 small-12 cell bg-color-ui-01 main-content">
                        <div class="spacer section"></div>
                        {{ content_for_layout }}
                        <div class="spacer section"></div>
                    </div>
                </div>
            </div>
        </div>                       
    </div>
    {% if context.params.slug == 'profile' %}
        {% assign stickyFooter = true %}
    {% endif %}

    {% include 'layout/footer' stickyFooter: stickyFooter%}

</body>
</html>