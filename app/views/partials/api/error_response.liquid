---
metadata: {
    partial_name: "Dashboard | API Error Response",
}
---
{%- comment -%}
  Standardized error response partial for API endpoints
  Parameters:
    - error_type: Type of error (validation, authorization, server, etc.)
    - errors: Error object or JSON string
    - status_code: HTTP status code (400, 401, 403, 404, 500, etc.)
{%- endcomment -%}

{%- liquid
  assign error_type = error_type | default: "validation"
  assign status_code = status_code | default: 400
  
  # Handle errors - could be a Liquid object (form.errors) or JSON string
  assign errors_obj = errors
  if errors.first[0] == blank
    # Try to parse as JSON string if it's not already an object
    assign errors_obj = errors | parse_json
  endif
-%}

{%- parse_json response -%}
{
  "success": false,
  "errors": {{ errors_obj | json }},
  "error_type": {{ error_type | json }},
  "status_code": {{ status_code }},
  "valid": false
}
{%- endparse_json -%}
{{ response }}

