---
metadata: {
    partial_name: "Account | Change Password Form",
}
---
{%- comment -%}
  The change-password form on the profile page. It posts to /profile/password, which signs
  the user out once the password has changed. Called with:
    render 'account/change_password_form', errors: errors
  errors: { "password": code } from the profile page, or empty.
{%- endcomment -%}
{%- function password_error = 'account/details/messages', field: 'password', code: errors.password -%}
<form id="user-password-form" class="insites-form insites-form-code" action="/profile/password" method="post" novalidate onsubmit="return UserProfileScript.methods.validateForm(event);">
  <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
  <div class="insites-form-grid seedling-form-container seedling-form-container-profile">
    <div class="form-group" active>
      <div class="column-1">
        <ins-input validate
          id="password"
          label="New Password"
          field="password"
          name="password"
          {% if password_error != blank %}has-error{% endif %}
          error-message="{{ password_error | default: 'Invalid password' }}"
          placeholder="New password">
        </ins-input>
      </div>

      <div class="column-1">
        <ins-input validate
          id="password_confirmation"
          label="Password Confirmation"
          field="password"
          name="password_confirmation"
          error-message="Password doesn't match"
          placeholder="Confirm new password">
        </ins-input>
      </div>

      <div class="column-1 profile-buttons">
        <ins-button id="save-password-btn" label="Update Password" icon="icon-key" solid type="submit"></ins-button>
      </div>
    </div>
  </div>
</form>
