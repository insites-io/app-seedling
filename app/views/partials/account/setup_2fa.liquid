---
metadata: {
    partial_name: "2FA | 2FA setup",
}
---
{%- comment -%}
  Turns 2FA on from the profile page: shows a QR code and the secret, and posts the first
  code from the authenticator app to /account/2fa. Called with:
    render 'account/setup_2fa'
{%- endcomment -%}
{%- comment -%} Clears the session flags the Insites admin keeps for its own 2FA and single sign-on. {%- endcomment -%}
{%- include 'modules/insites_crm/sessions/delete_session_variables' -%}
{%- liquid
  assign issuer = 'Insites Instance ' | append: context.instance.name
  graphql generated = 'account/2fa/generate_secret_key', email: context.current_user.email, issuer: issuer
  assign user = generated.items.results | first
  assign otp = user.otp
-%}
<form action="/account/2fa" method="post" accept-charset="utf-8">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <div class="setup-2fa-container">
        <div class="grid-x">
            <div class="large-12 cell text-left">
                <h4>Your account is not protected with two-factor authentication</h4>
                <div class="spacer small"></div>
                <p class="paragraph-medium">
                    Use the Google or Microsoft Authenticator App to scan this QR code to set up your verification device.
                </p>
                <div class="spacer"></div>
            </div>
            <div class="large-12 cell text-center">
                <div class="qr-code-details-wrapper">
                    <div class="qr-code qr-code-left">
                        {% print otp.secret_as_svg_qr_code %}
                    </div>
                    <div class="form-label">
                        <div class="spacer small"></div>
                        <p class="text-left">Or enter the code manually</p>
                        <div class="spacer x-small"></div>
                    </div>
                    <div class="manual-code-wrap">
                        <div class="manual-code-content wrap-content manual-code-content-left">
                            <pre id="setup_code">{{ otp.secret }}</pre>
                            <div class="copy-btn">
                                <span class="icon-content_copy"></span>
                            </div>
                        </div>
                    </div>
                    <div class="spacer x-large"></div>

                    <h5 class="title-5 text-left">Verification Code</h5>
                    <p class="paragraph-small text-left">Enter the verification code generated by your authentication app to enable two-factor authentication.</p>
                    <div class="spacer"></div>

                    <div class="otp-input-wrapper manual-code-content-left">
                        <input name="2fa[otp_code]" type="hidden">
                        <input name="from_page" type="hidden" value="profile">

                        <div class="otp_input_fields">
                            {%- for i in (0..5) -%}
                                <input inputmode="numeric" pattern="[0-9]*" type="text" maxlength="1" class="otp_input" autocomplete="off" required disabled/>
                            {%- endfor -%}
                        </div>
                    </div>
                    {%- if context.params.status == 'failed' -%}
                        <div class="spacer x-small"></div>
                        <p class="paragraph-small is-invalid-label text-left">Invalid code please try again.</p>
                    {%- endif -%}
                    <ins-button type="submit" class="hide fa-btn qr-code-left" label="Turn on Two-Factor Authentication" id="submit_button" solid color="blue" size="large"></ins-button>
                </div>
            </div>
        </div>
    </div>
</form>

<script src="{{ 'scripts/2fa/otp.js' | asset_url }}"></script>
