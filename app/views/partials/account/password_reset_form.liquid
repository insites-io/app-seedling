---
metadata: {
    partial_name: "Account | Password Reset Form",
}
---
{%- comment -%}
  Posts to the password-reset submit page, which checks the token again before
  changing the password. Called with: context, email, token.
{%- endcomment -%}
<div class="password-reset-wrapper">

  <div class="spacer section"></div>

  <div class="grid-x align-center">
    <div class="large-offset-4 large-5 medium-offset-3 medium-8 small-12 cell seedling-form-container">
        <h1 class="heading-1 text-center">Password Reset</h1>

        <div class="spacer xxxx-large"></div>

          <form id="password-reset-form" action="/password-reset" method="post" novalidate enctype="multipart/form-data" onsubmit="return LoginScript.methods.validateForm(event)">
            {% render 'modules/insites_crm/authenticity_token', context: context %}

            <div class="grid-x grid-padding-x">
              <div class="small-12 cell">
                <input name="token" value="{{ token }}" type="hidden">
                <input name="email" value="{{ email }}" type="hidden">

                <ins-input validate
                  id="password"
                  label="New Password"
                  field="password"
                  name="password"
                  {% if context.params.error == 'mismatch' %}
                  has-error
                  error-message="Password doesn't match"
                  {% elsif context.params.error == 'invalid_password' %}
                  has-error
                  error-message="Invalid password"
                  {% else %}
                  error-message="Invalid password"
                  {% endif %}
                  placeholder="Enter your new password">
                </ins-input>

                <ins-input validate
                  id="password_confirmation"
                  label="Confirm New Password"
                  field="password"
                  name="password_confirmation"
                  {% if context.params.error == 'mismatch' %}
                  has-error
                  error-message="Password doesn't match"
                  {% else %}
                  error-message="Invalid password"
                  {% endif %}
                  placeholder="Re-enter your new password">
                </ins-input>
              </div>

              <div class="small-12 cell spacer small"></div>

              <div class="small-12 cell text-center">
                <ins-button id="submit-btn" class="full" label="RESET PASSWORD" solid color="blue" type="submit" size="normal"></ins-button>
              </div>
            </div>
          </form>
    </div>
  </div>
  <div class="spacer section"></div>
</div>
