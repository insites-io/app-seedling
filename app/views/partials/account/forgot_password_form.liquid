---
metadata: {
    partial_name: "Account | Forgot Password Form",
}
---
{%- comment -%}
  The forgot-password form. Called with:
    render 'account/forgot_password_form', email: email, error: error
  error: 'invalid', 'too_many', 'unavailable' or 'session' for a message, or blank.
{%- endcomment -%}
{%- liquid
  comment
    An output tag on this platform turns an escaped double quote back into a quote, so a
    value that goes into an attribute is escaped here and written with print.
  endcomment
  assign email_attr = email | escape
-%}
<div class="forgot-password-wrapper">
<div class="spacer section"></div>
    <div class="sign-up grid-x">
        <div class="large-offset-4 large-5 medium-offset-3 medium-8 small-12 cell seedling-form-container">
            <h1 class="heading-1 text-center">Forgot your password?</h1>
            <div class="spacer x-small"></div>
            <p class="text-center">Enter your email address below and we'll get you back on track.</p>
            <div class="spacer xxx-large"></div>

            <form id="forgot-password-form" action="/forgot-password" method="post" novalidate onsubmit="return FormValidation.validateAndSubmit(event);">
                <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
                <div class="grid-x grid-padding-x">
                    <div class="small-12 cell">
                        <ins-input validate
                            id="email"
                            label="Email"
                            field="email"
                            name="email"
                            value="{% print email_attr %}"
                            {% if error == 'invalid' %}has-error{% endif %}
                            error-message="Please use a valid email address"
                            placeholder="Email">
                        </ins-input>
                    </div>

                    <div class="small-12 cell spacer small">
                        {%- if error == 'too_many' -%}
                            <p class="error-message">Too many requests. Please wait 15 minutes and try again.</p>
                        {%- elsif error == 'unavailable' -%}
                            <p class="error-message">Password reset by email is not available right now. Please contact the site owner.</p>
                        {%- elsif error == 'session' -%}
                            <p class="error-message">Your session has expired. Please try again.</p>
                        {%- endif -%}
                    </div>

                    <div class="small-12 cell text-center">
                        <ins-button id="submit-btn" class="full" label="SUBMIT" solid color="blue" type="submit"></ins-button>
                    </div>

                    <div class="small-12 cell spacer x-large"></div>

                    <div class="small-12 cell text-center seedling-form-container-link">
                        Back to <a href="/sign-in">sign in</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script defer src="{{ 'scripts/login-scripts.js' | asset_url }}"></script>
