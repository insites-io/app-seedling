---
metadata: {
    partial_name: "Lib | Register error",
}
---
{% comment %}
  @params
    contract - { errors: {}, valid: true }
    field_name
    message:
    key: i18n to be resolved into message
{% endcomment %}

{% liquid
  if key
    assign msg = key | t
  else
    assign msg = message
  endif

  assign errors = contract.errors
  assign field_errors = errors[field_name]
  if field_errors == blank
    assign field_errors = []
  endif
  assign field_errors = field_errors | array_add: msg

  assign errors[field_name] = field_errors
  assign contract['errors'] = errors
  assign contract['valid'] = false

  return contract
%}
