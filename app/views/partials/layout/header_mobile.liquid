---
metadata: {
    partial_name: "Layout | Header mobile default",
}
---
{%- comment -%}
  The mobile menu drawer. Called with:
    render 'layout/header_mobile'
{%- endcomment -%}
{%- liquid
  assign full_name = context.current_user.first_name | append: ' ' | append: context.current_user.last_name | strip
  assign full_name_attr = full_name | escape
-%}
<div class="navigation-05b drawer-holder mobile-menu-container hide-for-large">
  <ins-drawer no-padding id="mobile-menu" show-header="false" class="mobileNav hide-for-large hide-for-small">
    <div>
      <ul class="vertical menu">
        {%- if context.current_user == blank -%}
          <li class="no-submenu mobile-menu-style sign-in-button">
            <a href="/sign-in"><i class="icon-user"></i> Sign In</a>
          </li>
          <li class="no-submenu mobile-menu-style">
            <a href="/register" class="colorBlack">
              <ins-button class="register-mobile-button" label="REGISTER" type="button" size="normal" solid></ins-button>
            </a>
          </li>
        {%- else -%}
          <li class="no-submenu mobile-menu-style">
            <a class="colorBlack" href="/dashboard">Dashboard</a>
          </li>
          <li class="mobile-menu-style">
            <ins-accordion menu>
              <ins-accordion-item heading="{% print full_name_attr %}" link="#" open-icon="icon-plus" close-icon="icon-minus" class="has-subitems">
                <ins-accordion-link label="Profile" link="/profile" link-target="_self"></ins-accordion-link>
                <div class="sign-out-wrapper">
                  {%- render 'account/sign_out_form' -%}
                </div>
              </ins-accordion-item>
            </ins-accordion>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </ins-drawer>
</div>
