---
name: two_factor_alert
to: '{{ data.to }}'
from: >
  {%- include 'emails/autoresponder_from' -%}
reply_to: >
  {%- include 'emails/autoresponder_reply_to' -%}
subject: Security alert for your account
layout: modules/insites_crm/external_email_layout
metadata: {
  email_name: 'Two-Factor Alert'
}
---

  {%- include 'modules/insites_crm/email_layout/email_icon' -%}

  <table class="module" role="module" data-type="text" border="0" cellpadding="0"
    cellspacing="0" width="100%" style="table-layout: fixed;">
    <tbody>
      <tr>
        <td style="padding:0px 24px 24px 24px; line-height:24px; text-align:inherit;"
          height="100%" valign="top" bgcolor="" role="module-content">
          <div style="font-family: inherit; text-align: center">
            <span style="font-size: 24px"><strong>Security alert</strong></span>
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  <table class="module" role="module" data-type="text" border="0" cellpadding="0"
    cellspacing="0" width="100%" style="table-layout: fixed;">
    <tbody>
      <tr>
        <td style="padding:0px 24px 0px 24px; line-height:24px; text-align:inherit;"
          height="100%" valign="top" bgcolor="" role="module-content">
          <div style="font-family: inherit; text-align: center">
            <span style="white-space: pre-wrap">Someone entered the correct password for your account, then the wrong security codes too many times.</span><br>
            <br>
            <span style="white-space: pre-wrap">If this was not you, reset your password now so they cannot keep trying.</span>
            {%- if data.reset_required %}
            <br><br>
            <span style="white-space: pre-wrap"><strong>For your security, your account now needs a password reset before you can sign in again.</strong></span>
            {%- endif %}
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  <table class="module" role="module" data-type="spacer" border="0" cellpadding="0"
    cellspacing="0" width="100%" style="table-layout: fixed;">
    <tbody>
      <tr>
        <td style="padding:0px 0px 40px 0px;" role="module-content" bgcolor=""></td>
      </tr>
    </tbody>
  </table>

  <table border="0" cellpadding="0" cellspacing="0" class="module" data-role="module-button"
    data-type="button" role="module" style="table-layout:fixed;" width="100%">
    <tbody>
      <tr>
        <td align="center" bgcolor="" class="outer-td" style="padding:0px 24px 0px 24px;">
          <table border="0" cellpadding="0" cellspacing="0" class="wrapper-mobile" style="text-align:center;">
            <tbody>
              <tr>
                <td align="center" bgcolor="" class="inner-td"
                  style="border-radius:6px; font-size:16px; text-align:center; background-color:inherit;">
                  <a href="{{ platform_context.host }}/forgot-password"
                    style="background-color:#333333; border:0px solid #333333; border-color:#333333; border-radius:4px; border-width:0px; color:#ffffff; display:inline-block; font-size:16px; font-weight:700; letter-spacing:0px; line-height:normal; padding:16px 40px 16px 40px; text-align:center; text-decoration:none; border-style:solid; font-family:arial,helvetica,sans-serif;"
                    target="_blank">Reset Password</a>
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
