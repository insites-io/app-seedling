---
name: is_2fa_activated
redirect_to: 403
metadata: {
    "auth_policy_name": "2FA Configuration"
}
---

{% liquid
  graphql check_2fa_setup = 'account/check_2fa_setup'
  assign user = check_2fa_setup.current_user.client | first

  comment
    Guard 2FA-protected actions by requiring the profile and an activated OTP
    flag. Missing profile denies by default.
  endcomment
  if user == blank
    echo false
    return
  endif

  comment
    Allow only when OTP is explicitly true. An empty or missing flag denies.
  endcomment
  if user.otp_configured == true
    echo true
  else
    echo false
  endif
%}
